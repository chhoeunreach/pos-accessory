###############################################################################
#                                                                             #
#   Application                                                                #
#                                                                             #
###############################################################################

APP_NAME="Ultimate POS"
APP_TITLE="Ultimate POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Purchase details from the vendor. These are filled in by the web installer.
ENVATO_PURCHASE_CODE=
ENVATO_EMAIL=
ENVATO_USERNAME=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
#                                                                             #
#   Primary database                                                           #
#                                                                             #
#   The web installer rewrites the keys in this section.                      #
#                                                                             #
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ultimate_pos
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_FOREIGN_KEYS=true

# Path to a CA certificate when the server requires TLS.
MYSQL_ATTR_SSL_CA=

###############################################################################
#                                                                             #
#   Additional databases                                                       #
#                                                                             #
#   Username and password fall back to the primary credentials above when    #
#   they are left blank.                                                       #
#                                                                             #
###############################################################################

# Loan Management module
DB_LOAN_HOST=127.0.0.1
DB_LOAN_PORT=3306
DB_LOAN_DATABASE=s_loanmanagement
DB_LOAN_USERNAME=
DB_LOAN_PASSWORD=
DB_LOAN_SOCKET=

# Accessory module
ACCESSORY_DB_HOST=127.0.0.1
ACCESSORY_DB_PORT=3306
ACCESSORY_DB_DATABASE=s_accessory
ACCESSORY_DB_USERNAME=
ACCESSORY_DB_PASSWORD=
ACCESSORY_DB_SOCKET=
ACCESSORY_MYSQL_ATTR_SSL_CA=

# Service module
SERVICE_DB_HOST=127.0.0.1
SERVICE_DB_PORT=3306
SERVICE_DB_DATABASE=s_services
SERVICE_DB_USERNAME=
SERVICE_DB_PASSWORD=
SERVICE_DB_SOCKET=
SERVICE_MYSQL_ATTR_SSL_CA=

# HR module
HR_DB_HOST=127.0.0.1
HR_DB_PORT=3306
HR_DB_DATABASE=hr
HR_DB_USERNAME=
HR_DB_PASSWORD=
HR_DB_SOCKET=
HR_MYSQL_ATTR_SSL_CA=

###############################################################################
#                                                                             #
#   Cache, session and queue                                                   #
#                                                                             #
###############################################################################

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Leave blank for the default cookie name derived from the application URL.
SESSION_COOKIE=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_CONNECTION=

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false

###############################################################################
#                                                                             #
#   Mail                                                                       #
#                                                                             #
#   The web installer rewrites the keys in this section.                      #
#                                                                             #
###############################################################################

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=pos@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs"

POSTMARK_TOKEN=
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

###############################################################################
#                                                                             #
#   Filesystem / object storage                                                #
#                                                                             #
###############################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

DROPBOX_ACCESS_TOKEN=

BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=

###############################################################################
#                                                                             #
#   API authentication (Laravel Passport)                                     #
#                                                                             #
#   Run "php artisan passport:keys" to generate these.                        #
#                                                                             #
###############################################################################

PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

###############################################################################
#                                                                             #
#   PDF generation                                                             #
#                                                                             #
###############################################################################

WKHTMLTOPDF_ENABLED=true
WKHTMLTOPDF_BINARY="/usr/bin/wkhtmltopdf"
WKHTMLTOIMAGE_BINARY="/usr/bin/wkhtmltoimage"
TESSERACT_PATH="/usr/bin/tesseract"

###############################################################################
#                                                                             #
#   Telegram notifications                                                     #
#                                                                             #
###############################################################################

TELEGRAM_BOT_TOKEN=

###############################################################################
#                                                                             #
#   Payment gateways                                                          #
#                                                                             #
###############################################################################

STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=
PAYPAL_SANDBOX_API_USERNAME=
PAYPAL_SANDBOX_API_PASSWORD=
PAYPAL_SANDBOX_API_SECRET=
PAYPAL_SANDBOX_API_CERTIFICATE=
PAYPAL_LIVE_API_USERNAME=
PAYPAL_LIVE_API_PASSWORD=
PAYPAL_LIVE_API_SECRET=
PAYPAL_LIVE_API_CERTIFICATE=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=USD
PESAPAL_LIVE=false
PESAPAL_CALLBACK_ROUTE=/pesapal/callback

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

###############################################################################
#                                                                             #
#   Modules                                                                    #
#                                                                             #
###############################################################################

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_NAME=Super Admin
ADMIN_USERNAME=admin
ADMIN_BUSINESS_ID=1
ADMINISTRATOR_USERNAMES=admin

ALLOW_REGISTRATION=false
ACTIVITY_LOGGER_ENABLED=true
SHOW_REPAIR_STATUS_LOGIN_SCREEN=false
DO_NOT_ALLOW_DISPOSABLE_EMAIL=false
ENABLE_GST_REPORT_INDIA=false
ENABLE_RECAPTCHA=false
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

POS_RECENT_TRANSACTIONS_DISPLAY_LIMIT=10
DATATABLES_ERROR=false

###############################################################################
#                                                                             #
#   HR / Loan Management                                                       #
#                                                                             #
###############################################################################

HR_APP_URL=http://localhost/hr
HR_STORAGE_PATH=
HR_SELL_OUT_PHOTO_PATH=
HR_STAFF_AVATAR_PATH=

LOAN_MANAGEMENT_WEBSITE_URL=http://localhost
LOAN_CHAT_BROADCASTING_ENABLED=false
LOAN_CHAT_REALTIME_DRIVER=log
LOAN_CHAT_POLLING_INTERVAL=5000
LOAN_CHAT_POLLING_SECONDS=5
LOAN_CUSTOMER_API_DRIVER=log

###############################################################################
#                                                                             #
#   Notifications                                                              #
#                                                                             #
###############################################################################

NOTIFICATION_QUEUE_ENABLED=false
NOTIFICATION_PDF_ENGINE=wkhtmltopdf
NOTIFICATION_CLEANUP_DAYS=30
NOTIFICATION_RETRY_ATTEMPTS=3

###############################################################################
#                                                                             #
#   Imports and exports                                                        #
#                                                                             #
###############################################################################

IMPORT_QUEUE=imports
EXPORT_QUEUE=exports
IMPORT_DISK=local
EXPORT_DISK=local
IMPORT_CHUNK_SIZE=500
EXPORT_CHUNK_SIZE=500
IMPORT_MAX_UPLOAD_KB=102400
IMPORT_CLEANUP_AFTER_DAYS=7
EXPORT_CLEANUP_AFTER_DAYS=7
EXPORT_DOWNLOAD_TTL_HOURS=24

###############################################################################
#                                                                             #
#   External services                                                          #
#                                                                             #
###############################################################################

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_TIMEOUT=60
OPENAI_PRODUCT_PHOTO_MODEL=gpt-4o
OPENAI_ID_CARD_MODEL=gpt-4o

GOOGLE_MAP_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_CLOUD_VISION_KEY=
GOOGLE_CLOUD_VISION_ENDPOINT=
GOOGLE_CLOUD_VISION_TIMEOUT=30

CAMBODIA_ADDRESS_API_URL=
CAMBODIA_ADDRESS_CACHE_DAYS=30
CAMBODIA_ADDRESS_PAGE_SIZE=100
CAMBODIA_ADDRESS_PAGES_PER_REQUEST=1
CAMBODIA_ADDRESS_RETRY_AFTER_SECONDS=5
CAMBODIA_ADDRESS_TIMEOUT=30
CAMBODIA_ADDRESS_VERIFY_SSL=true

MY_FATOORAH_API_KEY=
MY_FATOORAH_COUNTRY_ISO=kh
MY_FATOORAH_IS_TEST=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

ABLY_KEY=

###############################################################################
#                                                                             #
#   Development only                                                           #
#                                                                             #
###############################################################################

DEBUGBAR_ENABLED=false
BCRYPT_ROUNDS=10
HASH_DRIVER=bcrypt
